# Copy to frontend/.env.local (gitignored). All values are public: no keys here.
# Empty or invalid values fall back to the Studionet defaults below, except the
# contract address: without it the site shows a "no contract configured" notice.

# GreenClaimBond contract on Studionet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x1f55BBf41a944666B287a802CC98c118e14f0932

# GenLayer network
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN
