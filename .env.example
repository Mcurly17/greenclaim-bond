# Copy to .env (gitignored) and fill locally. Never commit real values.
# Use throwaway test wallets that hold no mainnet funds.

# Signer keys for `gltest` integration tests and `npm run greenclaim`.
# 1 = brand, 2 = challenger.
ACCOUNT_PRIVATE_KEY_1=
ACCOUNT_PRIVATE_KEY_2=

# `npm run greenclaim` settings.
# GENLAYER_NETWORK: localnet, studionet or testnet-bradbury.
GENLAYER_NETWORK=studionet
# Optional GenLayer node RPC override (Bradbury Phase 2 node RPC for gen_* calls).
GENLAYER_RPC=
# Deployed GreenClaimBond address.
GREENCLAIM_CONTRACT=
# Which ACCOUNT_PRIVATE_KEY_<n> signs: 1 or 2.
GREENCLAIM_SIGNER=1

# Integration test inputs (see tests/integration/test_green_claim_bond.py).
GREENCLAIM_IT_PAGE=
GREENCLAIM_IT_QUOTE=
GREENCLAIM_IT_RULE=R1
GREENCLAIM_IT_EXPECT=
